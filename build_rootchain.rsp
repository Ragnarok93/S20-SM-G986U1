-fPIC
-shared
-pthread
-O2
-g0
-Wall
-Wextra
-Wno-unused-parameter
-Wno-sign-compare
-Wno-unused-function
-Isrc
-DKS_BUILD_S3=1
-DKS_BUILD_ROOTCHAIN=1
-DKS_ROOTCHAIN_LINK=1
-DTARGET_CONFIG_H=targets/alioth-4.19.157-perf/target.h
-Wl,-e,_start
-Wl,--version-script=src/s2_export.map
-o build/alioth/bin/preload_rootchain_bridge.so
src/rootchain_bridge.c
src/slide_s3.c
src/util.c
src/s2_support.c
src/fops.c
src/pipe.c
src/root.c
src/preload.c
src/su_blob.S
src/wallpaper_blob.S
src/dso_start.S
