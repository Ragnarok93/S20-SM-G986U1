-fPIC
-shared
-pthread
-O2
-g0
-Wall
-Wextra
-Wno-unused-parameter
-Wno-sign-compare
-Wno-unused-function
-Isrc/closed_loop
-Isrc
-D__USE_GNU=1
-DKS_BUILD_S3=1
-DKS_BUILD_ROOTCHAIN=1
-DKS_ROOTCHAIN_LINK=1
-DKS_BUILD_CLOSED_LOOP=1
-DTARGET_CONFIG_H=targets/alioth-4.19.157-perf/target.h
-Wl,-e,_start
-Wl,--version-script=src/s2_export.map
-o build/alioth/bin/preload_closed_loop.so
src/closed_loop/phase_controller.c
src/closed_loop/binding_renderer.c
src/closed_loop/bucket_answer.c
src/closed_loop/util.c
src/rootchain_bridge.c
src/slide_s3.c
src/s2_support.c
src/fops.c
src/pipe.c
src/root.c
src/preload.c
src/su_blob.S
src/wallpaper_blob.S
src/dso_start.S
